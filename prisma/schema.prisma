// Sketchling data model.
// SQLite for local development; switch `provider` to "postgresql" for production.
// Roles and statuses are stored as strings so the schema stays portable (see src/lib/roles.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id           String          @id @default(cuid())
  name         String
  slug         String          @unique
  city         String?
  country      String?
  logoUrl      String?
  color        String          @default("#5b5bf6")
  /// Code students type on /join to create their own account in this school.
  joinCode     String          @unique
  active       Boolean         @default(true)
  maxStudents  Int?
  contactEmail String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  users        User[]
  access       SchoolBook[]
  requests     AccessRequest[]
  scans        ScanEvent[]
}

model User {
  id           String      @id @default(cuid())
  name         String
  /// Login identifier: an email for staff, a short handle for students.
  username     String      @unique
  passwordHash String
  /// Sessions issued before this are signed out (see isRevoked in src/lib/session.ts).
  passwordChangedAt DateTime?
  /// SUPER_ADMIN | SCHOOL_ADMIN | STUDENT | PARENT
  role         String      @default("STUDENT")
  grade        String?
  active       Boolean     @default(true)
  schoolId     String?
  school       School?     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lastLoginAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  scans        ScanEvent[]
  children     Child[]
  likes        BookLike[]
  ratings      BookRating[]
  storyRequests StoryRequest[]
  /// Custom stories made for this family.
  ownedBooks   Book[]      @relation("OwnedBooks")

  @@index([schoolId, role])
}

/// A parent's child. Only what a story needs: a first name or nickname, an age and what they love.
model Child {
  id        String         @id @default(cuid())
  parentId  String
  parent    User           @relation(fields: [parentId], references: [id], onDelete: Cascade)
  name      String
  age       Int?
  interests String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  requests  StoryRequest[]

  @@index([parentId])
}

model Subject {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  /// Key into SUBJECT_ICONS (src/lib/subject-icons.tsx)
  icon        String   @default("atom")
  color       String   @default("#5b5bf6")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  books       Book[]
}

/// A printed book (or chapter). All of its pages are compiled into one .mind file.
model Book {
  id          String          @id @default(cuid())
  title       String
  description String?
  gradeLevel  String?
  coverUrl    String?
  /// Printed page size: A5 | SKETCH | A4 | LETTER | SQUARE (src/lib/book-format.ts)
  format      String          @default("A5")
  published   Boolean         @default(false)
  /// Shown first on the home page.
  featured    Boolean         @default(false)
  /// A custom story made for one family: only its owner (and admins) can open it, and it never
  /// appears in the library. Null for library books, which are free for everyone.
  ownerId     String?
  owner       User?           @relation("OwnedBooks", fields: [ownerId], references: [id], onDelete: SetNull)
  /// Library counters, kept in step with BookLike/BookRating by src/server/actions/library.ts.
  downloads   Int             @default(0)
  likeCount   Int             @default(0)
  ratingCount Int             @default(0)
  ratingAvg   Float           @default(0)
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  mindUrl     String?
  /// Signature of the targets that went into mindUrl; differs from the live signature when a recompile is needed.
  mindHash    String?
  compiledAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  targets     Target[]
  access      SchoolBook[]
  requests    AccessRequest[]
  scans       ScanEvent[]
  likes       BookLike[]
  ratings     BookRating[]
  storyRequest StoryRequest?

  @@index([subjectId])
  @@index([published, ownerId])
}

model BookLike {
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, bookId])
  @@index([bookId])
}

/// One star rating (1–5) per reader per book.
model BookRating {
  userId    String
  bookId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  stars     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([userId, bookId])
  @@index([bookId])
}

/// A parent asking for a story written for their child, around something they want the child to
/// learn or think about (src/lib/stories.ts).
model StoryRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId     String?
  child       Child?    @relation(fields: [childId], references: [id], onDelete: SetNull)
  /// Copied from the child so the request still reads right if the profile changes.
  childName   String
  childAge    Int?
  /// Key into STORY_GOALS
  goal        String
  /// The lesson in the parent's own words.
  message     String
  /// Things the child loves, to weave into the story.
  interests   String?
  /// BCP 47 code, e.g. "en", "fr", "ar"
  language    String    @default("en")
  /// NEW | IN_PROGRESS | DELIVERED | DECLINED
  status      String    @default("NEW")
  /// Shown to the parent.
  adminNote   String?
  /// The story being made, owned by the parent.
  bookId      String?   @unique
  book        Book?     @relation(fields: [bookId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deliveredAt DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// One page of a book. Pages with `ar` are compiled as image targets; the others are story pages
/// that only appear in the reader and in print.
model Target {
  id          String      @id @default(cuid())
  bookId      String
  book        Book        @relation(fields: [bookId], references: [id], onDelete: Cascade)
  name        String
  description String?
  translations Json?
  imageUrl    String
  width       Int
  height      Int
  order       Int         @default(0)
  ar          Boolean     @default(true)
  /// Position of this target inside the book's compiled .mind file.
  targetIndex Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  contents    Content[]
  scans       ScanEvent[]

  @@index([bookId, order])
}

/// Something shown when a target is recognised. Transforms are in target space:
/// 1 unit = target width, origin = target centre, +Z = out of the page. Rotations in degrees.
model Content {
  id        String   @id @default(cuid())
  targetId  String
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  /// MODEL | VIDEO | IMAGE | AUDIO | TEXT
  type      String
  name      String
  url       String?
  text      String?
  color     String?
  posX      Float    @default(0)
  posY      Float    @default(0)
  posZ      Float    @default(0)
  rotX      Float    @default(0)
  rotY      Float    @default(0)
  rotZ      Float    @default(0)
  scale     Float    @default(1)
  autoplay  Boolean  @default(true)
  loop      Boolean  @default(true)
  /// Animation clip to play for MODEL; null plays every clip.
  animation String?
  /// Transform animation as JSON (src/lib/motion-schema.ts): a preset (spin, float…) or keyframes.
  motion    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetId])
}

/// Which books a school's students can use.
model SchoolBook {
  schoolId  String
  bookId    String
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  grantedAt DateTime @default(now())

  @@id([schoolId, bookId])
  @@index([bookId])
}

/// A school asking the platform admin for access to a book.
model AccessRequest {
  id        String    @id @default(cuid())
  schoolId  String
  bookId    String
  school    School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  book      Book      @relation(fields: [bookId], references: [id], onDelete: Cascade)
  /// PENDING | APPROVED | REJECTED
  status    String    @default("PENDING")
  message   String?
  createdAt DateTime  @default(now())
  decidedAt DateTime?

  @@index([status])
  @@index([schoolId, bookId])
}

model ScanEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  targetId  String
  target    Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([bookId, createdAt])
  @@index([createdAt])
}
