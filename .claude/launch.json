{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arlive",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "arlive-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "arlive-phone",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:phone"
      ],
      "port": 3000
    },
    {
      "name": "sketchbook-example",
      "runtimeExecutable": "py",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "sketchbook-exemple"
      ],
      "port": 4173
    }
  ]
}
