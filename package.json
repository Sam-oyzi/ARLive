{
  "name": "pagewakes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:phone": "tsx scripts/dev-phone.ts",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "admin:create": "tsx scripts/create-admin.ts",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "assets:sample": "tsx scripts/make-sample-assets.ts",
    "optimize:glb": "tsx scripts/optimize-glb.ts",
    "dev:vinext": "npm run dev:worker",
    "build:vinext": "npm run build:worker",
    "start:vinext": "npm run preview:worker",
    "deploy:vinext": "npm run deploy:worker",
    "dev:worker": "prisma generate --generator workerClient && vite dev --port 3001",
    "build:worker": "prisma generate --generator workerClient && vite build",
    "preview:worker": "vite preview",
    "deploy:worker": "npm run build:worker && node scripts/cloudflare-run.mjs cf deploy --prebuilt",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "canvas": "file:./stubs/canvas"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.49.0",
    "meshoptimizer": "^1.3.0",
    "mind-ar": "^1.2.5",
    "motion": "^13.5.0",
    "next": "^16.4.5",
    "opentype.js": "^2.0.0",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.12",
    "@cloudflare/workers-types": "5.20261106.1",
    "@gltf-transform/cli": "^4.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vinext/cloudflare": "1.3.3",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "cf": "1.0.0-beta.28",
    "jpeg-js": "^0.4.4",
    "prisma": "^6.19.3",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vinext": "1.4.4",
    "vite": "8.3.0",
    "wrangler": "4.158.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25 || >=26.12.0"
  }
}
