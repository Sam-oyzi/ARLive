# SQLite for local dev. For production use PostgreSQL: change the provider in prisma/schema.prisma
# and set e.g. DATABASE_URL="postgresql://user:pass@host:5432/arlive"
DATABASE_URL="file:./dev.db"
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"
