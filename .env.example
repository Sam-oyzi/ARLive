# SQLite for local development. The Cloudflare build uses its native D1 binding.
DATABASE_URL="file:./dev.db"
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"
# Public address of the site, printed into the QR code on each book's back cover (e.g. https://pagewakes.com).
# Leave empty in development: the QR then uses this computer's Wi-Fi address so a phone can open it.
SITE_URL=""
# Production bindings and public URL are in cloudflare.config.ts.
# SESSION_SECRET is stored as a Cloudflare Worker secret, outside Git.
